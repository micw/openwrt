diff --git a/board/mediatek/mt7628/lt22m.c b/board/mediatek/mt7628/lt22m.c
new file mode 100644
--- /dev/null
+++ b/board/mediatek/mt7628/lt22m.c
@@ -0,0 +1,309 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Tuoshi LT22M: import the unique LAN MAC from read-only Factory data. */
+
+#include <button.h>
+#include <command.h>
+#include <cyclic.h>
+#include <env.h>
+#include <image.h>
+#include <init.h>
+#include <led.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <net.h>
+#include <spi_flash.h>
+#include <stdio.h>
+#include <string.h>
+
+#define LT22M_FACTORY_OFFSET		0x40000
+#define LT22M_LAN_MAC_OFFSET		0x28
+#define LT22M_FIRMWARE_OFFSET		0x50000
+#define LT22M_FIRMWARE_SIZE		0xfb0000
+#define LT22M_KERNEL_LOAD_ADDR		0x82000000
+/* Keep the compressed image below relocated U-Boot; decompressed kernels
+ * are limited to 16 MiB by CONFIG_SYS_BOOTM_LEN at 0x80000000.
+ */
+#define LT22M_MAX_KERNEL_IMAGE_SIZE	0x800000
+
+#define LT22M_LED_2G	BIT(0)
+#define LT22M_LED_3G	BIT(1)
+#define LT22M_LED_4G	BIT(2)
+#define LT22M_LED_ALL	(LT22M_LED_2G | LT22M_LED_3G | LT22M_LED_4G)
+
+static struct udevice *lt22m_leds[6];
+static struct cyclic_info lt22m_tftp_led_cyclic;
+static bool lt22m_tftp_receiving;
+
+static void lt22m_leds_init(void)
+{
+	static const char *const labels[] = {
+		"lt22m:2g", "lt22m:3g", "lt22m:4g",
+		"lt22m:wlan", "lt22m:lan0", "lt22m:lan1"
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(labels); i++) {
+		if (led_get_by_label(labels[i], &lt22m_leds[i]))
+			printf("LT22M: status LED %s unavailable\n", labels[i]);
+	}
+}
+
+static void lt22m_leds_set(unsigned int mask)
+{
+	int i;
+
+	/* Existing recovery and error patterns control only the mobile LEDs. */
+	for (i = 0; i < 3; i++) {
+		if (lt22m_leds[i])
+			led_set_state(lt22m_leds[i], mask & BIT(i) ?
+				      LEDST_ON : LEDST_OFF);
+	}
+}
+
+static void lt22m_front_leds_set(enum led_state_t state)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(lt22m_leds); i++) {
+		if (lt22m_leds[i])
+			led_set_state(lt22m_leds[i], state);
+	}
+}
+
+static void lt22m_leds_blink(unsigned int period_ms)
+{
+	int i;
+
+	for (i = 0; i < 3; i++) {
+		if (lt22m_leds[i] &&
+		    !led_set_period(lt22m_leds[i], period_ms))
+			led_set_state(lt22m_leds[i], LEDST_BLINK);
+	}
+}
+
+static void lt22m_leds_error(void)
+{
+	int i;
+
+	for (i = 0; i < 3; i++) {
+		lt22m_leds_set(LT22M_LED_ALL);
+		mdelay(120);
+		lt22m_leds_set(0);
+		mdelay(120);
+	}
+}
+
+static void lt22m_tftp_led_progress(struct cyclic_info *cyclic)
+{
+	if (!lt22m_tftp_receiving && net_boot_file_size) {
+		lt22m_tftp_receiving = true;
+		lt22m_leds_blink(250);
+	}
+}
+
+static bool lt22m_valid_ram_image(u32 received, bool recovery)
+{
+	struct legacy_img_hdr *hdr = (void *)LT22M_KERNEL_LOAD_ADDR;
+
+	if (received <= sizeof(*hdr) ||
+	    received > LT22M_MAX_KERNEL_IMAGE_SIZE ||
+	    !image_check_magic(hdr) || !image_check_hcrc(hdr) ||
+	    !image_check_os(hdr, IH_OS_LINUX) ||
+	    !image_check_type(hdr, IH_TYPE_KERNEL) ||
+	    !image_check_target_arch(hdr) ||
+	    image_get_image_size(hdr) != received ||
+	    !image_check_dcrc(hdr))
+		return false;
+
+	/* Restrict recovery to the expected standalone OpenWrt kernel format.
+	 * Exact received length rejects appended SquashFS, but a forged uImage
+	 * is still possible: CRC is integrity, NOT authentication.
+	 */
+	return !recovery || (image_get_magic(hdr) == IH_MAGIC &&
+			     image_get_load(hdr) == 0x80000000 &&
+			     image_get_ep(hdr) == 0x80000000 &&
+			     image_get_comp(hdr) == IH_COMP_LZMA);
+}
+
+static int lt22m_recovery(void)
+{
+	int ret;
+
+	if (!env_get("ipaddr"))
+		env_set("ipaddr", "192.168.188.1");
+
+	puts("LT22M: RAM-only TFTP recovery. Upload a standard OpenWrt initramfs\n");
+	puts("LT22M: to the router IP; no SPI erase/write is performed.\n");
+	puts("LT22M: CRC is not authentication; use an isolated trusted LAN.\n");
+	for (;;) {
+		lt22m_leds_blink(1000);
+		lt22m_tftp_receiving = false;
+		image_load_addr = LT22M_KERNEL_LOAD_ADDR;
+		cyclic_register(&lt22m_tftp_led_cyclic, lt22m_tftp_led_progress,
+				100000, "lt22m_tftp_led");
+		ret = net_loop(TFTPSRV);
+		cyclic_unregister(&lt22m_tftp_led_cyclic);
+
+		if (ret == -EINTR) {
+			lt22m_leds_set(0);
+			return CMD_RET_FAILURE;
+		}
+		if (ret > 0 &&
+		    lt22m_valid_ram_image(net_boot_file_size, true)) {
+			printf("LT22M: verified %u-byte RAM recovery image\n",
+			       net_boot_file_size);
+			lt22m_leds_set(LT22M_LED_ALL);
+			mdelay(250);
+			lt22m_front_leds_set(LEDST_OFF);
+			/* A successful kernel boot never returns. */
+			run_command("bootm 0x82000000", 0);
+			puts("LT22M: recovery kernel returned unexpectedly\n");
+		} else {
+			puts("LT22M: TFTP failed or image invalid; retrying\n");
+		}
+		lt22m_leds_error();
+	}
+}
+
+static int do_lt22mrecovery(struct cmd_tbl *cmdtp, int flag, int argc,
+			    char *const argv[])
+{
+	return lt22m_recovery();
+}
+
+U_BOOT_CMD(lt22mrecovery, 1, 0, do_lt22mrecovery,
+	   "receive and boot a checked OpenWrt initramfs via TFTP (RAM only)", "");
+
+static int lt22m_boot_failure(void)
+{
+	/* All three radio-generation LEDs on together cannot be normal LTE. */
+	lt22m_leds_set(LT22M_LED_ALL);
+	mdelay(1000);
+	return lt22m_recovery();
+}
+
+static int do_lt22mboot(struct cmd_tbl *cmdtp, int flag, int argc,
+			char *const argv[])
+{
+	struct legacy_img_hdr hdr;
+	struct legacy_img_hdr *loaded = (void *)LT22M_KERNEL_LOAD_ADDR;
+	struct spi_flash *flash;
+	u32 size;
+	int ret;
+
+	flash = spi_flash_probe(CONFIG_SF_DEFAULT_BUS, CONFIG_SF_DEFAULT_CS,
+				CONFIG_SF_DEFAULT_SPEED, CONFIG_SF_DEFAULT_MODE);
+	if (!flash) {
+		puts("LT22M: cannot probe SPI NOR for firmware\n");
+		return lt22m_boot_failure();
+	}
+
+	ret = spi_flash_read(flash, LT22M_FIRMWARE_OFFSET, sizeof(hdr), &hdr);
+	if (ret || !image_check_magic(&hdr) || !image_check_hcrc(&hdr) ||
+	    !image_check_os(&hdr, IH_OS_LINUX) ||
+	    !image_check_type(&hdr, IH_TYPE_KERNEL) ||
+	    !image_check_target_arch(&hdr)) {
+		puts("LT22M: no valid Linux uImage header at 0x50000\n");
+		goto fail;
+	}
+
+	size = image_get_image_size(&hdr);
+	if (size <= sizeof(hdr) || size > LT22M_MAX_KERNEL_IMAGE_SIZE ||
+	    size > LT22M_FIRMWARE_SIZE ||
+	    flash->size <= LT22M_FIRMWARE_OFFSET ||
+	    size > flash->size - LT22M_FIRMWARE_OFFSET) {
+		puts("LT22M: firmware kernel image exceeds safe RAM/flash bounds\n");
+		goto fail;
+	}
+
+	ret = spi_flash_read(flash, LT22M_FIRMWARE_OFFSET, size, loaded);
+	spi_flash_free(flash);
+	if (ret || !image_check_magic(loaded) || !image_check_hcrc(loaded) ||
+	    image_get_image_size(loaded) != size ||
+	    !image_check_dcrc(loaded)) {
+		puts("LT22M: firmware kernel readback or CRC failed\n");
+		return lt22m_boot_failure();
+	}
+
+	printf("LT22M: booting verified %u-byte kernel from 0x50000\n", size);
+	lt22m_leds_set(LT22M_LED_ALL);
+	mdelay(250);
+	lt22m_front_leds_set(LEDST_OFF);
+	/* A successful kernel boot never returns. */
+	run_command("bootm 0x82000000", 0);
+	puts("LT22M: firmware kernel returned unexpectedly\n");
+	return lt22m_boot_failure();
+
+fail:
+	spi_flash_free(flash);
+	return lt22m_boot_failure();
+}
+
+U_BOOT_CMD(lt22mboot, 1, 0, do_lt22mboot,
+	   "boot verified Linux uImage from LT22M firmware in SPI NOR", "");
+
+int board_late_init(void)
+{
+	struct spi_flash *flash;
+	struct udevice *reset_button;
+	u8 mac[6];
+	char mac_string[ARP_HLEN_ASCII + 1];
+	int ret;
+	int cmd_ret, delay_ret;
+
+	/* The saved stock environment can contain any bootcmd. Never execute
+	 * a legacy command implicitly: always use the bounded, checked NOR
+	 * boot or button-selected RAM-only recovery. Do not call saveenv().
+	 */
+	cmd_ret = env_set("bootcmd", "lt22mboot");
+	delay_ret = env_set("bootdelay", "3");
+	if (cmd_ret || delay_ret)
+		puts("LT22M: could not set RAM-only boot policy\n");
+
+	lt22m_leds_init();
+	/* Match stock U-Boot: all six front LEDs lit until kernel handoff. */
+	lt22m_front_leds_set(LEDST_ON);
+
+	if (!button_get_by_label("reset", &reset_button) &&
+	    button_get_state(reset_button) == BUTTON_ON) {
+		/* Require a deliberate hold, not a short switch bounce. */
+		mdelay(1000);
+		if (button_get_state(reset_button) == BUTTON_ON) {
+			puts("LT22M: reset held at power-on; RAM-only TFTP recovery\n");
+			cmd_ret = env_set("bootcmd", "lt22mrecovery");
+			delay_ret = env_set("bootdelay", "1");
+			if (cmd_ret || delay_ret)
+				puts("LT22M: could not select RAM recovery\n");
+		}
+	}
+
+	/* Runs after env_import and before Ethernet initialization. Never
+	 * write back to the legacy U-Boot environment or to Factory.
+	 */
+	flash = spi_flash_probe(CONFIG_SF_DEFAULT_BUS, CONFIG_SF_DEFAULT_CS,
+				CONFIG_SF_DEFAULT_SPEED, CONFIG_SF_DEFAULT_MODE);
+	if (!flash) {
+		puts("LT22M: cannot probe SPI NOR for Factory MAC\n");
+		return 0;
+	}
+
+	ret = spi_flash_read(flash, LT22M_FACTORY_OFFSET +
+			     LT22M_LAN_MAC_OFFSET, sizeof(mac), mac);
+	spi_flash_free(flash);
+	if (ret || !is_valid_ethaddr(mac)) {
+		puts("LT22M: missing or invalid Factory LAN MAC\n");
+		return 0;
+	}
+
+	/* eth_env_set_enetaddr() refuses to replace an existing valid MAC,
+	 * even with CONFIG_ENV_OVERWRITE. Set the checked Factory value via
+	 * env_set() directly, in RAM only; never save the old environment.
+	 */
+	snprintf(mac_string, sizeof(mac_string), "%pM", mac);
+	if (env_set("ethaddr", mac_string))
+		puts("LT22M: could not set Factory LAN MAC in RAM\n");
+
+	return 0;
+}

