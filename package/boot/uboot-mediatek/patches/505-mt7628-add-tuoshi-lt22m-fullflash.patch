diff --git a/arch/mips/dts/tuoshi_lt22m_fullflash.dts b/arch/mips/dts/tuoshi_lt22m_fullflash.dts
new file mode 100644
--- /dev/null
+++ b/arch/mips/dts/tuoshi_lt22m_fullflash.dts
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Tuoshi LT22M: full 16-MiB NOR firmware layout.
+ * U-Boot, environment and unique factory data remain outside the firmware
+ * partition. This DT alone neither erases the old stock slots nor boots Linux.
+ */
+
+/dts-v1/;
+
+#include "mt7628a.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+
+/ {
+	compatible = "tuoshi,lt22m", "ralink,mt7628a-soc";
+	model = "Tuoshi LT22M 4G Wireless Router";
+
+	aliases {
+		serial0 = &uart0;
+		spi0 = &spi0;
+	};
+
+	chosen {
+		stdout-path = &uart0;
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		wlan {
+			label = "lt22m:wlan";
+			gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;
+		};
+
+		lan0 {
+			label = "lt22m:lan0";
+			gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;
+		};
+
+		lan1 {
+			label = "lt22m:lan1";
+			gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
+		};
+
+		mobile-2g {
+			label = "lt22m:2g";
+			gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
+		};
+
+		mobile-3g {
+			label = "lt22m:3g";
+			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
+		};
+
+		mobile-4g {
+			label = "lt22m:4g";
+			gpios = <&gpio1 5 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	keys {
+		compatible = "gpio-keys";
+
+		reset {
+			label = "reset";
+			gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+		};
+	};
+};
+
+&state_default {
+	board-leds-reset {
+		/* U-Boot uses wled_a/p0led_a/p1led_a where Linux uses
+		 * wled_an/p0led_an/p1led_an. GPIO 0/2: i2s; 37: refclk;
+		 * 38: wdt; 42/43/44: LAN1/LAN0/WLAN LED anodes.
+		 */
+		groups = "i2s", "refclk", "wdt", "p0led_a", "p1led_a",
+			 "wled_a";
+		function = "gpio";
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&spi0 {
+	status = "okay";
+	num-cs = <1>;
+
+	spi-flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <25000000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "u-boot";
+				reg = <0x000000 0x030000>;
+				read-only;
+			};
+
+			partition@30000 {
+				label = "u-boot-env";
+				reg = <0x030000 0x010000>;
+				read-only;
+			};
+
+			partition@40000 {
+				label = "factory";
+				reg = <0x040000 0x010000>;
+				read-only;
+			};
+
+			partition@50000 {
+				label = "firmware";
+				reg = <0x050000 0xfb0000>;
+			};
+		};
+	};
+};
+
+&eth {
+	/* Physical ports 0 and 1 are LAN; do not isolate WAN port 0. */
+	pinctrl-names = "default";
+	pinctrl-0 = <&ephy_router_mode>;
+};

diff --git a/board/mediatek/mt7628/Makefile b/board/mediatek/mt7628/Makefile
new file mode 100644
--- /dev/null
